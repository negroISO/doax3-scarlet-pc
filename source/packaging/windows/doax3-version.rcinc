// Product labels shared by the runtime, capability checker and play shortcut.
#ifndef DOAX3_RESOURCE_VERSION
#define DOAX3_RESOURCE_VERSION 1,8,0,0
#endif
#ifndef DOAX3_VERSION_STRING
#define DOAX3_VERSION_STRING "1.08 candidate"
#endif
#ifndef DOAX3_PRODUCT
#define DOAX3_PRODUCT "DOAX3 Scarlet"
#endif
1 VERSIONINFO
FILEVERSION DOAX3_RESOURCE_VERSION
PRODUCTVERSION DOAX3_RESOURCE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", DOAX3_DESCRIPTION
            VALUE "FileVersion", DOAX3_VERSION_STRING
            VALUE "OriginalFilename", DOAX3_FILENAME
            VALUE "ProductName", DOAX3_PRODUCT
            VALUE "ProductVersion", DOAX3_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
