#!/usr/bin/env bash
# AppImage entry point: starts the frozen Tk launcher. The launcher picks the game folder, runs
# run.py and handles --play (the game without a window, for Steam and shortcuts).
# Usage: doax3-scarlet-x86_64.AppImage [--play]
set -euo pipefail
here=$(dirname -- "$(readlink -f -- "$0")")
share=$here/usr/share/theorder

export LD_LIBRARY_PATH="$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export THEORDER_DATA_DIR=${THEORDER_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/theorder}
mkdir -p "$THEORDER_DATA_DIR"

cd -- "$share"
exec "$share/theorder-launcher" "$@"
